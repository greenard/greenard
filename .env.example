# Copier en .env puis adapter. Ne jamais versionner .env.
POSTGRES_PASSWORD=change-me
GREENARD_SECRET_KEY=change-me-with-64-random-characters
GREENARD_HOSTNAME=greenard.intranet.local
# "internal" (certificat CA interne Caddy) ou "/certs/cert.pem /certs/key.pem"
GREENARD_TLS=internal
# Usage de l'instance : internal (non commercial) | commercial
GREENARD_DEPLOYMENT_USAGE=internal
GREENARD_COOKIE_SECURE=true
GREENARD_ELEVATION_ALERT_M=100
GREENARD_ICON_EU_MARGIN_CELLS=5
# Fichier de grille ICON complet (facultatif, cellule contenant le site) : chemin dans /data
# GREENARD_ICON_GRID_FILE=/data/icon_grid_0026_R03B07_G.nc
# Tuiles MNT locales (facultatif, sinon Copernicus GLO-30 sur AWS)
# GREENARD_DEM_LOCAL_DIR=/data/dem
# Proxy sortant de l'entreprise (facultatif)
# HTTPS_PROXY=http://proxy.entreprise:3128
# Fond de carte : style MapLibre (URL) ; vide = tuiles OpenStreetMap
# VITE_MAP_STYLE_URL=
